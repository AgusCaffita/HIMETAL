generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            Int             @id @unique @default(autoincrement())
  email         String          @unique
  password      String
  nombre        String?
  apellido      String?
  rol           String          @default("user")
  users_pedidos users_pedidos[]
}

model users_pedidos {
  user_id   Int
  pedido_id Int
  pedido    pedido @relation(fields: [pedido_id], references: [id])
  users     users  @relation(fields: [user_id], references: [id])

  @@id([user_id, pedido_id])
}

model pedido {
  id               Int                @id @unique @default(autoincrement())
  codigo           String?
  presupuesto      Int?
  estado           String             @default("Pendiente")
  pedido_articulos pedido_articulos[]
  user_pedidos     users_pedidos[]
}

model pedido_articulos {
  pedido_id   Int
  articulo_id Int
  cantidad    Int      @default(1)
  articulo    articulo @relation(fields: [articulo_id], references: [id])
  pedido      pedido   @relation(fields: [pedido_id], references: [id])

  @@id([pedido_id, articulo_id])
}

model articulo {
  id               Int                @id @unique @default(autoincrement())
  codigo           String?
  descripcion      String?
  cant_piezas      Int?
  precio           Int?
  cte_ganancia     Int?
  plano_file       String?
  articulo_piezas  articulo_piezas[]
  pedido_articulos pedido_articulos[]
}

model articulo_piezas {
  articulo_id Int
  pieza_id    Int
  articulo    articulo @relation(fields: [articulo_id], references: [id])
  pieza       pieza    @relation(fields: [pieza_id], references: [id])

  @@id([articulo_id, pieza_id])
}

model pieza {
  id                    Int               @id @unique @default(autoincrement())
  nombre                String?
  precio_mat_prima      Int?
  cte_ganancia          Int?
  plano_laser_DXF_file  String?
  plano_pleg_DWG_file   String?
  plano_pleg_SOLID_file String?
  articulo_piezas       articulo_piezas[]
}
